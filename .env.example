# Скопируйте этот файл в .env и подставьте свои значения. Файл .env не попадает в git.

# Ключ Gemini API: https://aistudio.google.com
GEMINI_API_KEY=your_api_key_here

# Модель Gemma 4 через Gemini API (точное имя — в списке моделей AI Studio)
GEMMA_MODEL=models/gemma-4-31b-it

# Необязательно: запасные модели Gemma через запятую, если основная перегружена
GEMMA_FALLBACKS=

# Необязательно: локальная модель в Ollama на случай недоступности API
OLLAMA_MODEL=

# Необязательно: лимит запросов в минуту и временная публичная ссылка (1 = включить)
RATE_LIMIT_PER_MINUTE=15
SHARE=0
